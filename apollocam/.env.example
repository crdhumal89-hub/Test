# ApolloCAM Phase 2 — Environment Configuration
# Copy to .env and fill in values. Never commit .env to source control.

# SMTP for email (leave blank to use Windows Outlook COM instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Admin password (overrides the database setting when set)
ADMIN_PASSWORD=ApolloAdmin2026

# Database path (defaults to apollocam/data/apollocam.db)
DB_PATH=
